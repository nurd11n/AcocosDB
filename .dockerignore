*.pyc
db.sqlite3
media/
staticfiles/
backups/
# Caddy's access log (bind-mounted from the host). Not secret, but it's
# runtime data that would bloat every image build for no reason.
caddy_logs/
.pytest_cache/
.ruff_cache/
*.mo
