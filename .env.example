# --- Django core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
# Comma-separated. In prod: your real domain(s) only.
ALLOWED_HOSTS=localhost,127.0.0.1
# In prod: https://your-domain.example
CSRF_TRUSTED_ORIGINS=
# TOTP 2FA on the admin login. The admin is mounted at the site root ("/"), so
# it's easy for scanners to find — 2FA is forced ON in prod settings regardless
# of this value; this only controls dev.
OTP_ENABLED=True
TIME_ZONE=Asia/Bishkek
# Base currency that Exchange rates (Система) are quoted against. Every sale,
# payment, and price is entered/stored in its OWN currency (KGS/USD/RUB, fixed
# in apps.core.currency) — this only sets which one ExchangeRate rates convert to.
CURRENCY=KGS

# --- Database ---
# Local quick runs fall back to sqlite when unset. Docker compose uses postgres.
DATABASE_URL=postgres://acocos:change-me-db-password@db:5432/acocos
# Used by the db + backup containers (must match DATABASE_URL).
POSTGRES_DB=acocos
POSTGRES_USER=acocos
POSTGRES_PASSWORD=change-me-db-password

# --- Cache ---
# Local memory if empty — fine for `make dev`. REQUIRED in production (prod
# settings refuse to start without it): gunicorn runs multiple worker
# processes and only a shared cache keeps counters/report caching correct.
# Docker compose prod file provides a `redis` service — use redis://redis:6379/0
REDIS_URL=

# --- HTTPS (prod compose) ---
DOMAIN=crm.example.com

# --- Daily report (send_daily_report / scheduler service) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Comma-separated recipient addresses. Empty = email delivery is skipped.
REPORT_RECIPIENTS=
# HH:MM, local to TIME_ZONE above. The scheduler container wakes up and runs
# the report at this time every day.
REPORT_HOUR=21:00

# --- Telegram bots (two separate bots, two tokens — never share one) ---
# Staff bot: allowlisted BotUsers only (stock/revenue/debts/reports).
TELEGRAM_STAFF_TOKEN=
# Client bot: public — catalog, own orders, own debt only. Also sends campaigns.
TELEGRAM_CLIENT_TOKEN=

# --- Admin URL (the admin panel moves off "/" to make it harder to find) ---
ADMIN_URL=panel/

# --- Backups (backup + restore-drill services) ---
# age recipient PUBLIC key — dumps are encrypted to this before leaving the box.
# The matching PRIVATE key must NOT live on the server. Generate a keypair with
# `age-keygen -o age_identity.txt`; the file's "public key:" line is this value,
# and age_identity.txt goes to ./secrets/ (used only by the restore drill).
AGE_RECIPIENT=
# rclone destination for offsite copies, e.g. "b2:acocos-backups". Empty = local
# backups only (no offsite). Configure the B2 remote via the RCLONE_CONFIG_* vars
# below or a mounted rclone.conf.
RCLONE_REMOTE=
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
# Telegram chat that receives the weekly restore-drill result (success/failure).
DRILL_CHAT_ID=

# --- WhatsApp Cloud API (Phase 2 — leave empty until enabled) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret, used to verify webhook signatures. Webhook rejects POSTs when unset.
WHATSAPP_APP_SECRET=
