# --- Django core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
# Comma-separated. In prod: your real domain(s) only.
ALLOWED_HOSTS=localhost,127.0.0.1
# In prod: https://your-domain.example
CSRF_TRUSTED_ORIGINS=
# Admin panel path (never /admin/). Must end with a slash.
ADMIN_URL=panel/
# TOTP 2FA on the admin login. Forced ON in prod settings regardless of this value.
OTP_ENABLED=True
TIME_ZONE=Asia/Bishkek
CURRENCY=KGS

# --- Database ---
# Local quick runs fall back to sqlite when unset. Docker compose uses postgres.
DATABASE_URL=postgres://acocos:change-me-db-password@db:5432/acocos
# Used by the db + backup containers (must match DATABASE_URL).
POSTGRES_DB=acocos
POSTGRES_USER=acocos
POSTGRES_PASSWORD=change-me-db-password

# --- Cache (optional) ---
# When set, Django uses Redis for cache + sessions. Leave empty for local memory.
REDIS_URL=

# --- HTTPS (prod compose) ---
DOMAIN=crm.example.com

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Cloud API (Phase 2 — leave empty until enabled) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret, used to verify webhook signatures. Webhook rejects POSTs when unset.
WHATSAPP_APP_SECRET=
# Comma-separated phone numbers (digits only) allowed to talk to the WhatsApp bot.
WHATSAPP_ALLOWED_NUMBERS=
