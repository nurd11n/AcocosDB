# --- Django core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
# Comma-separated. In prod: your real domain(s) only.
ALLOWED_HOSTS=localhost,127.0.0.1
# In prod: https://your-domain.example
CSRF_TRUSTED_ORIGINS=
TIME_ZONE=Asia/Bishkek
# Base currency that Exchange rates (Система) are quoted against. Every sale,
# payment, and price is entered/stored in its OWN currency (KGS/USD/RUB, fixed
# in apps.core.currency) — this only sets which one ExchangeRate rates convert to.
CURRENCY=KGS
# A converted foreign payment above this many сом requires an explicit second
# confirmation tap on top of the primary "Подтвердить продажу" button (also
# triggered by a stale (4+ day) or manually-overridden rate — never blocks).
LARGE_PAYMENT_THRESHOLD_KGS=10000
# Change (сдача) rounds DOWN to the nearest step of physical cash, in сом.
CHANGE_ROUNDING_STEP=1.00
# A computed change above this many сом needs the same explicit second
# confirmation as a stale/manual-rate/large payment — never blocks.
CHANGE_CONFIRM_THRESHOLD_KGS=5000
# Two-factor login (django-otp) — code defaults this to True. On a FIRST-EVER
# deploy, leave it unset (True) and follow the README's "First login" bootstrap
# (createsuperuser -> addstatictoken -> enroll a real device). On an UPGRADE of
# an already-running instance with existing logged-in users, set this to False
# for the first restart, let everyone log in normally and enroll a device at
# /otp/enroll/, THEN flip it to True and restart again — see README's "Enabling
# 2FA on an existing deployment" section. Skipping the staged rollout on an
# upgrade locks out every user with no enrolled device until an operator runs
# addstatictoken for them by hand.
OTP_ENABLED=True

# --- Feature flags ---
# Bots are NOT production-ready — ship every flag below False at go-live.
# Off means: bot/main.py idles (no Telegram polling), the /wa/webhook/ route
# 404s regardless of WhatsApp credentials, the Рассылки admin + send_campaign
# refuse, the Входящие nav item and dashboard bot panels are hidden, and the
# daily report skips Telegram delivery (email still sends). Flip to True only
# once the bots are actually staffed and ready to go live.
BOTS_ENABLED=False
WHATSAPP_ENABLED=False
CAMPAIGNS_ENABLED=False

# --- Database ---
# Local quick runs fall back to sqlite when unset. Docker compose uses postgres.
DATABASE_URL=postgres://acocos:change-me-db-password@db:5432/acocos
# Used by the db + backup containers (must match DATABASE_URL).
POSTGRES_DB=acocos
POSTGRES_USER=acocos
POSTGRES_PASSWORD=change-me-db-password

# --- Cache ---
# Local memory if empty — fine for `make dev`. REQUIRED in production (prod
# settings refuse to start without it): gunicorn runs multiple worker
# processes and only a shared cache keeps counters/report caching correct.
# Docker compose prod file provides a `redis` service — use redis://redis:6379/0
REDIS_URL=

# --- HTTPS (prod compose) ---
DOMAIN=crm.example.com

# --- Email: the daily report goes through this ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Comma-separated recipient addresses. Empty = email delivery is skipped.
REPORT_RECIPIENTS=
# HH:MM, local to TIME_ZONE above. The scheduler container wakes up and runs
# the report at this time every day.
REPORT_HOUR=21:00
# HH:MM — the scheduler also pulls fresh NBKR rates automatically at this time
# every day (on top of the manual «Обновить» button on the POS Курс card).
RATES_HOUR=08:00
# Optional proxy for the NBKR rate feed ONLY. nbkr.kg blocks many foreign/cloud
# IP ranges (a DigitalOcean droplet can't reach it), so route just this one
# request through a proxy located somewhere NBKR allows. Formats:
#   socks5://host:1080            (e.g. an SSH tunnel: ssh -D on a KG-reachable box)
#   http://user:pass@host:8080
# Empty = fetch NBKR directly (fine anywhere the server can reach nbkr.kg).
NBKR_PROXY=

# --- On-server database snapshots (scheduler runs `manage.py backup_db`) ---
# Comma-separated HH:MM times (TIME_ZONE) to take a local, checksummed DB
# snapshot into backups/snapshots/ — the always-available backup floor that
# needs no age/rclone/B2 (works on sqlite and postgres alike). Default is
# every 6 hours. The prod Docker `backup` service adds encryption + offsite
# B2 on top; this is the copy that always exists on the box.
SNAPSHOT_HOURS=00:00,06:00,12:00,18:00
# Where snapshots are written (kept under gitignored backups/). Leave blank
# for the default: <project>/backups/snapshots/.
# BACKUP_SNAPSHOT_DIR=
# Retention (days): keep every snapshot for N days, then one/day, then one/week.
SNAPSHOT_KEEP_ALL_DAYS=7
SNAPSHOT_KEEP_DAILY_DAYS=30
SNAPSHOT_KEEP_WEEKLY_DAYS=183

# --- Telegram bots (two separate bots, two tokens — never share one) ---
# Staff bot: allowlisted BotUsers only (stock/revenue/debts/reports).
TELEGRAM_STAFF_TOKEN=
# Client bot: public — catalog, own orders, own debt only. Also sends campaigns.
TELEGRAM_CLIENT_TOKEN=

# --- Admin URL (the admin panel moves off "/" to make it harder to find) ---
ADMIN_URL=panel/

# --- Backups (backup + restore-drill services) ---
# BOTH AGE_RECIPIENT and RCLONE_REMOTE are REQUIRED — backup.sh refuses to run
# (exits non-zero, alerts) if either is unset (2026-08-18 audit, M3): a backup
# job that silently degrades to unencrypted or local-only dumps is worse than
# one that refuses to run at all.
# age recipient PUBLIC key — dumps are encrypted to this before leaving the box.
# The matching PRIVATE key must NOT live on the server. Generate a keypair with
# `age-keygen -o age_identity.txt`; the file's "public key:" line is this value,
# and age_identity.txt goes to ./secrets/ (used only by the restore drill).
AGE_RECIPIENT=
# rclone destination for offsite copies, e.g. "b2:acocos-backups". Configure
# the B2 remote via the RCLONE_CONFIG_* vars below or a mounted rclone.conf.
RCLONE_REMOTE=
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
# Telegram chat that receives backup-failure alerts AND the weekly
# restore-drill result (success/failure) — same chat, both scripts.
DRILL_CHAT_ID=
# Optional dead-man's-switch (e.g. a healthchecks.io check URL): pinged once
# at the end of every completed backup cycle. Catches the case Telegram
# alerts above can't — the backup not running AT ALL (host down, container
# never starts) — since healthchecks.io alerts on a MISSING ping, not a sent
# one. Leave blank to disable.
HEALTHCHECKS_PING_URL=

# --- WhatsApp Cloud API (Phase 2 — leave empty until enabled) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret, used to verify webhook signatures. Webhook rejects POSTs when unset.
WHATSAPP_APP_SECRET=
# Broadcasts over WhatsApp stay off (send_campaign refuses) until both are set —
# an approved Meta template name is required, free-form bulk is never sent.
WHATSAPP_BROADCAST_ENABLED=False
WHATSAPP_TEMPLATE_NAME=
# Public https base of this deployment (e.g. https://crm.example.com) — used to
# build an absolute URL for a WhatsApp template's hero image (Meta can't fetch a
# relative /media path). Leave blank to send templates text-only.
PUBLIC_BASE_URL=
